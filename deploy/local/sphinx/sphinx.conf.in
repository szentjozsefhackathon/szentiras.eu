source parent_source {
	type			= pgsql
	sql_host		= __DB_HOST__
	sql_user		= __DB_USERNAME__
	sql_pass		= __DB_PASSWORD__
	sql_db			= __DB_DATABASE__
	sql_port		= __DB_PORT__
}

source verses_source : parent_source
{

	# Verse types are per translation: the same tip means different things in different
	# translations (e.g. 902 is a poem line in SZIT but unused leftover text in RUF), so the
	# filter must be keyed on trans as well. Keep in sync with the text/heading/poemLine
	# entries of config/translations.php; tests/Feature/SphinxIndexConfigTest.php fails when
	# the two drift apart.
	sql_query		= \
		SELECT id, gepi, trans, usx_code, chapter, tip, verse, verse as verse2, verse as verse3 \
		FROM kar_tdverse \
    WHERE (trans = 1 AND tip IN (901, 902, 3000, 3001, 3002, 3003, 3004, 3005, 3006)) \
       OR (trans = 2 AND tip IN (703, 901, 902)) \
       OR (trans = 3 AND tip IN (301, 320, 330, 640, 650, 680, 701, 702, 901, 902)) \
       OR (trans = 4 AND tip IN (1, 2, 3, 901, 902)) \
       OR (trans = 5 AND tip IN (701, 704, 901, 902)) \
       OR (trans = 6 AND tip IN (701, 901, 904)) \
       OR (trans = 7 AND tip IN (901, 902)) \
       OR (trans = 8 AND tip IN (901, 902)) \
       OR (trans = 9 AND tip IN (701, 901))

}


source verses_root_source : verses_source
{
    sql_query		= \
    SELECT id, gepi, trans, usx_code, chapter, tip, verseroot as verse, verseroot as verse2, verseroot as verse3 \
    FROM kar_tdverse \
    WHERE (trans = 1 AND tip IN (901, 902, 3000, 3001, 3002, 3003, 3004, 3005, 3006)) \
       OR (trans = 2 AND tip IN (703, 901, 902)) \
       OR (trans = 3 AND tip IN (301, 320, 330, 640, 650, 680, 701, 702, 901, 902)) \
       OR (trans = 4 AND tip IN (1, 2, 3, 901, 902)) \
       OR (trans = 5 AND tip IN (701, 704, 901, 902)) \
       OR (trans = 6 AND tip IN (701, 901, 904)) \
       OR (trans = 7 AND tip IN (901, 902)) \
       OR (trans = 8 AND tip IN (901, 902)) \
       OR (trans = 9 AND tip IN (701, 901))

}

source greekverse_source : parent_source
{
	sql_query = \
		SELECT id,  gepi, usx_code, chapter, verse, source, normalization \
		FROM kar_greek_verses
}

index greekverse
{
	source	= greekverse_source
	field = normalization
	attr_string = gepi	
	attr_string = usx_code
	attr_uint = chapter
	attr_uint = verse
	attr_string = source
	
	min_infix_len = 3
	charset_table = \
	    0..9, \
	    a..z, \
	    A..Z->a..z
}


index verse
{
	source	= verses_source
	
	field = verse, verse2, verse3
	attr_uint = trans
	attr_string = usx_code
	attr_uint = chapter
	attr_string = gepi
	attr_uint = tip

	min_infix_len = 3
	charset_table = \
	    0..9, \
	    a..z, \
	    A..Z->a..z, \
	    U+00E0..U+00FE, \
	    U+00C0..U+00DE->U+00E0..U+00FE, \
	    U+0151, U+0171, \
	    U+0150->U+0151, \
	    U+0170->U+0171
}

index verseroot : verse
{
    source = verses_root_source
}

indexer
{
	mem_limit		= 96M
}


searchd
{
	read_timeout	= 5
	max_children	= 30
	seamless_rotate	= 1
	preopen_indexes	= 1
	unlink_old		= 1
	workers			= threads # for RT to work
}

common
{
    datadir            = /opt/sphinx
}