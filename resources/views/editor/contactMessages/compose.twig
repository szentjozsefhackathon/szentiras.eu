{% extends 'layout' %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ route('editor.contactMessages.index') }}">Szerkesztői beérkezett üzenetek</a></li>
                    <li class="breadcrumb-item active">Új üzenet</li>
                </ol>
            </nav>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Címzett</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><code>{{ recipient.token }}</code></p>
                    {% if apiKeys.count > 0 %}
                        <p class="mb-1 text-muted small">API kulcsai:</p>
                        <ul class="mb-0 small">
                            {% for apiKey in apiKeys %}
                                <li>
                                    <a href="{{ route('editor.apiKeys.show', apiKey.id) }}">{{ apiKey.name }}</a>
                                    <code>{{ apiKey.key_prefix }}</code>
                                    {% if not apiKey.enabled %}
                                        <span class="badge bg-danger">Letiltva</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Üzenet küldése</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="{{ route('editor.contactMessages.send', recipient.id) }}">
                        {{ csrf_field() }}
                        <div class="mb-3">
                            <label for="message" class="form-label">Üzenet szövege</label>
                            <textarea
                                id="message"
                                name="message"
                                class="form-control {{ errors.has('message') ? 'is-invalid' : '' }}"
                                rows="6"
                                maxlength="2000"
                                required
                            >{{ old('message') }}</textarea>
                            {% if errors.has('message') %}
                                <div class="invalid-feedback d-block">{{ errors.first('message') }}</div>
                            {% endif %}
                            <div class="form-text">
                                A felhasználó az „Üzeneteim” oldalon látja az üzenetet, és ott válaszolhat rá.
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send"></i> Küldés
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
