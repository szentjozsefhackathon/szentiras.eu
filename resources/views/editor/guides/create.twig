{% extends 'layout.twig' %}
{% set pageTitle = 'Új útmutató/cikk | Szentírás' %}

{% block pageHeader %}
<div class="page-header mb-4">
    <h1>Új útmutató/cikk</h1>
    <p class="text-muted">Készíts online szerkeszthető, Markdown formátumú bejegyzést.</p>
</div>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <form action="{{ route('editor.guides.store') }}" method="POST">
                    {{ csrf_field() }}
                    {% include 'editor.guides._form' %}
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
