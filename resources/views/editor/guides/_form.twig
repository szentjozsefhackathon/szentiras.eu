{% if session('success') %}
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> {{ session('success') }}
    </div>
{% endif %}

{% if errors.any() %}
    <div class="alert alert-danger">
        <ul class="mb-0">
            {% for error in errors.all() %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<div class="mb-3">
    <label for="title" class="form-label">Cím <span class="text-danger">*</span></label>
    <input
        type="text"
        class="form-control"
        id="title"
        name="title"
        value="{{ old('title', guide is defined ? guide.title : '') }}"
        maxlength="255"
        required
        autofocus
    >
</div>

{% set tagNames = guide is defined ? guide.tags|map(tag => tag.name)|join(', ') : '' %}
<div class="mb-3">
    <label for="tags" class="form-label">Címkék</label>
    <input
        type="text"
        class="form-control"
        id="tags"
        name="tags"
        value="{{ old('tags', tagNames) }}"
        maxlength="500"
        placeholder="Útmutató, Bibliaolvasás"
    >
    <div class="form-text">
        A címkéket vesszővel válaszd el. Egy bejegyzéshez legfeljebb 10 címke adható.
    </div>
</div>

<div class="mb-3">
    <label for="content" class="form-label">Tartalom (Markdown) <span class="text-danger">*</span></label>
    <textarea
        class="form-control font-monospace"
        id="content"
        name="content"
        rows="20"
        required
        placeholder="## Első lépések"
    >{{ old('content', guide is defined ? guide.content : '') }}</textarea>
    <div class="form-text">
        Használható például: <code>## címsor</code>, <code>**félkövér**</code>, <code>*dőlt*</code>, listák és hivatkozások.
    </div>
</div>

<div class="form-check form-switch mb-4">
    <input type="hidden" name="is_active" value="0">
    <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="is_active"
        name="is_active"
        value="1"
        {{ old('is_active', guide is defined and guide.is_active ? '1' : '0') == '1' ? 'checked' : '' }}
    >
    <label class="form-check-label" for="is_active">Aktív, a nyilvános oldalon megjelenik</label>
</div>

<div class="d-flex flex-wrap justify-content-between gap-2">
    <a href="{{ route('editor.guides.index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Vissza a listához
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="bi bi-check-circle"></i> Mentés
    </button>
</div>
