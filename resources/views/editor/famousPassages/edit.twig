{% extends 'layout.twig' %}
{% set pageTitle = passage.name ~ ' szerkesztése | Szentírás' %}

{% block pageHeader %}
<div class="page-header mb-4">
    <h1>Szakasz szerkesztése</h1>
    <p class="text-muted">
        Nyilvános cím:
        <a href="{{ route('famousPassages.show', passage) }}" target="_blank">{{ route('famousPassages.show', passage) }}</a>
    </p>
</div>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card">
            <div class="card-body">
                <form action="{{ route('editor.famousPassages.update', passage) }}" method="POST">
                    {{ csrf_field() }}
                    {{ method_field('PUT') }}
                    {% include 'editor.famousPassages._form' %}
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
