<!DOCTYPE html>

<html lang="hu">
    <head>
        {% if app.environment != 'production' %}<meta name="robots" content="noindex,nofollow">{% endif %}
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ pageTitle ? pageTitle : metaTitle }}</title>

        <meta property="fb:admins" content="1819502454" />
        <meta property="fb:appId" content="{{ config_get('settings.facebookAppId') }}" />
		<meta property="og:type" content="website" />

        <meta name="description" content="{{ teaser ? teaser : 'A teljes Szentírás, azaz a Biblia magyarul az interneten: katolikus és protestáns fordításban' }}">
        <meta name="author" content="szentiras.eu">
        <meta http-equiv="cleartype" content="on">
        <meta name="csrf-token" content="{{ csrf_token() }}">
        {% include 'partials.loggedInMeta' %}

        {% block meta %}{% endblock %}
        <script>
            (function() {
                try {
                    var theme = localStorage.getItem('theme');
                    // Only apply stored theme if it's 'light' or 'dark'; treat 'system' and missing as system preference
                    if (theme === 'dark') {
                        document.documentElement.setAttribute('data-theme', 'dark');
                    } else if (theme === 'light') {
                        document.documentElement.removeAttribute('data-theme');
                    } else {
                        // No stored preference or 'system' theme, check system preference
                        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                            document.documentElement.setAttribute('data-theme', 'dark');
                        }
                    }
                } catch (e) {}
                try {
                    // Mirrors fontScale.js, applied before first paint so the text does not resize visibly
                    var scales = [1, 1.15, 1.3, 1.5, 1.75, 2];
                    var stored = parseFloat(localStorage.getItem('fontScale'));
                    if (isFinite(stored) && scales.indexOf(stored) > 0) {
                        document.documentElement.style.setProperty('--book-font-size', stored + 'rem');
                    }
                } catch (e) {}
                try {
                    // Mirrors readingPreferences.js, applied before first paint so the text does not restyle visibly
                    var preferenceAttributes = {
                        font: ['data-text-font', ['serif', 'sans', 'hyperlegible']],
                        weight: ['data-text-weight', ['normal', 'bold']],
                        spacing: ['data-text-spacing', ['normal', 'comfortable']],
                        align: ['data-text-align', ['justify', 'left']],
                        contrast: ['data-text-contrast', ['normal', 'high']]
                    };
                    var preferences = JSON.parse(localStorage.getItem('readingPreferences') || '{}');
                    Object.keys(preferenceAttributes).forEach(function (key) {
                        var attribute = preferenceAttributes[key][0];
                        var allowed = preferenceAttributes[key][1];
                        if (allowed.indexOf(preferences[key]) !== -1) {
                            document.documentElement.setAttribute(attribute, preferences[key]);
                        }
                    });
                    if (preferences.font === 'hyperlegible') {
                        var hyperlegible = document.createElement('link');
                        hyperlegible.rel = 'stylesheet';
                        hyperlegible.href = 'https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;1,400;1,600&display=swap';
                        hyperlegible.setAttribute('crossorigin', '');
                        hyperlegible.setAttribute('data-font', 'hyperlegible');
                        document.head.appendChild(hyperlegible);
                    }
                } catch (e) {}
            })();
        </script>
        <link rel="shortcut icon" type="image/vnd.microsoft.icon" href="/favicon.ico">
        <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" crossorigin>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin>
        <link rel="stylesheet" href="https://code.jquery.com/ui/1.11.4/themes/smoothness/jquery-ui.css" crossorigin>
        {{ vite('resources/assets/css/tailwind.css')|raw }}
        {{ vite('resources/assets/less/app.less')|raw }}
        

        {% block extraHead %}{% endblock %}

    </head>
    <body>
        <div id="interstitial"><span class="spinner-border"></span><span class="interstitial-text d-none d-md-inline"> Kis türelmet</span></div>
        <div class="container">
            {% include 'navbar' %}
            <div class="row">
                {% if hideLeftColumn is not defined or not hideLeftColumn %}
                <div class="col-lg-3 col-md-4">
                     {% include 'menu' %}
                     {% block extramenu %}{% endblock %}
                     {% if showRufAd %}
                        <div class="d-none d-md-block">{# Only show on medium and up #}
                            {% include 'RUFAd.twig' %}
                        </div>
                     {% endif %}
                </div>
                {% endif %}
                <div class="{% if hideLeftColumn is defined and hideLeftColumn %}col-lg-12 col-md-12{% else %}col-lg-9 col-md-8{% endif %}">
                   
                    {% block pageHeader %}{% endblock %}
                    <div class="mt-1">
                        <main>
                        {% block content %}{% endblock %}
                        </main>
                        <br />
                        {% block abbrevlist %}{% endblock %}
                    </div>
                    <div>
                        {% block comments %}{% endblock %}
                        {% if showRufAd %}
                            <div class="d-block d-md-none">{# Only show on small screens #}
                                {% include 'RUFAd.twig' %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <footer>
        <div class="footer">
            <p><br>Kérdéseket, ötleteket, problémákat <a href='mailto:eleklaszlosj@gmail.com'>Elek László SJ</a> (<a
                         href="http://jezsuita.hu">JTMR</a>) email-címén,<br>a <a href="{{ route('contact.form') }}">Kapcsolatfelvétel</a> űrlapon<br>és a Szentírás.eu fejlesztőinek hivatalos
                        <a href="https://www.facebook.com/szentiras.eu">Facebook</a> oldalán fogadjuk (bejegyzésben vagy Messengeren)!<br>
            {% if config_get('settings.discordInviteUrl') %}A fejesztőket közvetlenül elérheted a <strong>Szent József Hackathon</strong>
            <a href="{{ config_get('settings.discordInviteUrl') }}">Discordon</a>!<br>{% endif %}
            Fejlesztés: <a href="https://github.com/szentjozsefhackathon/szentiras.eu">GitHub</a>
                {% if config_get('version.hash') %}- <small>verzió:
                    <a href="https://github.com/szentjozsefhackathon/szentiras.eu/commit/{{ config_get('version.hash') }}">
                    {{ config_get('version.hash')[0:7] }}</a></small>{% endif %}<br>            
            </p>
        </div>
        </footer>
                
               <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
               <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js" integrity="sha256-AlTido85uXPlSyyaZNsjJXeCs07eSv3r43kyCVc8ChI=" crossorigin="anonymous"></script>               
               <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

        {{ vite('resources/assets/js/app.js')|raw }}
         {% for script in js %}
             {{ vite('resources/assets/js/' ~ script ~ '.js')|raw }}
         {% endfor %}
         {%block script%}{%endblock%}
    </body>
</html>
