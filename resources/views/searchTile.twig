<div class="card h-100 border-0" style="background-color: #f8f7f4;">
    <div class="card-body text-center">
        <div class="d-flex align-items-center justify-content-center mb-2">
            <i class="bi-search display-5 me-3" style="color: #7a9e87;"></i>
            <h5 class="card-title mb-0" style="color: #4a5568;">Keresés</h5>
        </div>

        <div class="mt-2 text-start">
        <form id="quickSearchForm" role="form" method="post" class="form-inline"
                action="/kereses/quicksearch">
            <div class="form-group">
                <div class="input-group">
                    <input id="quickSearch" autocomplete="off" type="text" class="form-control" name="textToSearch" value="{{ form.textToSearch }}" placeholder="Gyorskeresés" aria-label="Gyorskeresés" aria-describedby="quickSearchHelp" style="border-color: #d4cfc9; background-color: #fdfcfb;">
                    <input id="grouping" type="hidden" class="form-control" name="grouping" value="verse">
                    {{ csrf_field() }}
                    <div class="input-group-append position-relative">
                        <a href="javascript:void(0)" class="quickSearchButton btn btn-default" title="Keresés" aria-label="Keresés" style="color: #fff; background-color: #7a9e87; border-color: #7a9e87;">
                            <span id="quickSearchHitsButtonContent"><i class="bi-search"></i></span>
                            <span id="quickSearchResultsBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none z-3">
                                <span id="quickSearchResultsCount">0</span>
                                <span class="visually-hidden">találat</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
        <p id="quickSearchHelp" class="card-text small mt-1 mb-0" style="color: #718096;">Szavak, kifejezések vagy igehely (pl. Jn 3,16) a teljes Bibliában</p>

        <div class="row row-cols-1 row-cols-sm-2 g-2 mt-1">
            <div class="col">
                <a href="javascript:void(0)" role="button" class="quickSearchButton btn btn-default w-100" style="color: #6b6560; background-color: #ede9e4; border-color: #d4cfc9;"><i class="bi-gear me-1"></i> Részletes keresés</a>
                <p class="card-text small mt-1 mb-0" style="color: #718096;">Szavakra, kifejezésekre keres, fordítás és könyv szerint szűrve, csoportosítható találatokkal</p>
            </div>
            <div class="col">
                <a href="/ai-search" role="button" class="btn btn-default w-100" style="color: #6b6560; background-color: #ede9e4; border-color: #d4cfc9;"><i class="bi-robot me-1"></i> MI keresés</a>
                <p class="card-text small mt-1 mb-0" style="color: #718096;">Pontos szöveg nélkül is: jelentés szerint keres, az Egyház tanítását is figyelembe véve</p>
            </div>
        </div>
        </div>
    </div>
</div>
