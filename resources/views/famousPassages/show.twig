{% extends 'layout.twig' %}

{% block content %}
<article class="famous-passage my-4">
    <nav aria-label="Morzsamenü">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ route('famousPassages.index') }}">Nevezetes szentírási szakaszok</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ passage.name }}</li>
        </ol>
    </nav>

    {% if not passage.is_active %}
        <div class="alert alert-warning">Ez az oldal még nem nyilvános, csak a szerkesztők látják.</div>
    {% endif %}

    <header class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1 class="h2 mb-1">{{ passage.name }}</h1>
            {% if passage.alternative_names is not empty %}
                <p class="text-muted mb-1">Más néven: {{ passage.alternative_names|join(', ') }}</p>
            {% endif %}
            <p class="small text-muted mb-0">{{ passage.reference }}</p>
        </div>
        {% if isEditor() %}
            <a href="{{ route('editor.famousPassages.edit', passage) }}" class="btn btn-sm btn-outline-secondary text-nowrap">
                <i class="bi bi-pencil"></i> Szerkesztés
            </a>
        {% endif %}
    </header>

    {% if passage.introduction %}
        <p class="lead">{{ passage.introduction }}</p>
    {% endif %}

    <section id="szoveg" class="mb-4">
        <h2 class="h4">A szöveg <small class="text-muted fs-6">({{ translation.name }})</small></h2>
        {% for verseContainer in verseContainers %}
            {{ include('textDisplay.parsedVerseContainer', { 'verseContainer': verseContainer, 'translation': translation, 'verseToPlaces': [] }) }}
        {% endfor %}
        {# Loaded client-side from /api/commentaries/content, the same box as on the chapter pages #}
        <div class="commentary-container"
             data-reference="{{ passage.reference }}"
             data-translation="{{ translation.abbrev }}"
             data-container-index="0"></div>
    </section>

    {% if translationRows is not empty %}
        <section id="forditasok" class="mb-4">
            <h2 class="h4">{{ passage.key_verse ? passage.key_verse ~ ' különböző fordításokban' : 'Más fordításokban' }}</h2>
            <div class="list-group shadow-sm">
                {% for row in translationRows %}
                    <div class="list-group-item py-3">
                        {% if row.keyVerseText %}
                            <blockquote class="mb-1">{{ row.keyVerseText }}</blockquote>
                        {% endif %}
                        <a href="{{ row.url }}" class="small">{{ row.translation.name }} ({{ row.translation.abbrev }}) <i class="bi bi-chevron-right"></i></a>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if passage.church_citations is not empty %}
        <section id="egyhazi-dokumentumok" class="mb-4">
            <h2 class="h4">Az Egyház dokumentumaiban</h2>
            <p class="small text-muted">Ahol az Egyház tanítóhivatali dokumentumai ezt a szakaszt idézik, a saját szavaikkal.{% if magisterUrl %} A helyeket a <a href="{{ magisterUrl }}" target="_blank" rel="noopener">Hittéka</a>, az Egyház dokumentumainak forráskeresője gyűjtötte össze.{% endif %}</p>
            {% for group in passage.church_citations %}
                <h3 class="h5 mt-3">{{ group.title }}</h3>
                <div class="list-group shadow-sm">
                    {% for citation in group.citations %}
                        <div class="list-group-item py-3">
                            <blockquote class="mb-1">{{ citation.quote }}</blockquote>
                            <div class="small">
                                {% if citation.url %}
                                    <a href="{{ citation.url }}" target="_blank" rel="noopener">{{ citation.label }} <i class="bi bi-box-arrow-up-right"></i></a>
                                {% else %}
                                    {{ citation.label }}
                                {% endif %}
                                {% if citation.author %}<span class="text-muted">– {{ citation.author }}{{ citation.docType ? ', ' ~ citation.docType }}{{ citation.year ? ', ' ~ citation.year }}</span>{% endif %}
                                <span class="text-muted">· {{ citation.cites }}</span>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% if group.total > group.citations|length %}
                    <p class="small mt-1 mb-0">
                        {% if magisterUrl %}
                            <a href="{{ magisterUrl }}/?{{ { q: passage.reference, forras: group.key }|url_encode }}" target="_blank" rel="noopener">Mind a {{ group.total }} hely a Hittékában <i class="bi bi-box-arrow-up-right"></i></a>
                        {% else %}
                            <span class="text-muted">Összesen {{ group.total }} helyen idézik.</span>
                        {% endif %}
                    </p>
                {% endif %}
            {% endfor %}
        </section>
    {% endif %}

    {% if passage.content %}
        <section class="markdown-content mb-4">
            {{ passage.content|markdown_to_html|raw }}
        </section>
    {% endif %}
</article>
{% endblock %}

{% set js = ['commentary-status-polling'] %}
