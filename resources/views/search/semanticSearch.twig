{% extends 'layout' %}

{% set pageTitle %}
Keresés jelentés szerint mesterséges intelligencia segítségével | Szentírás
{% endset %}

{% block content %}
    <h4>Jelentés szerinti keresés</h4>
            <div class="card mb-2">
                <div class="card-body">                    
            <form role="form" class="form-horizontal" method="post"
                  action="{{ action('Search\\SemanticSearchController@anySearch') }}" id="semanticSearchForm">
                  {% if not session_get("anonymous_token") %}
                    <div class="alert alert-primary" role="alert">
                        Regisztráció/belépés nélkül is használhatod a szemantikus keresőt, de egy munkamenetben legfeljebb {{ config_get('settings.ai.unregisteredSearchLimit') }} keresést végezhetsz. 
                        Eddig {{ session_get('semanticSearchCalls', 0) }} keresést végeztél.
                        Ha többre van szükséged, <a href="/login?r={{ '/ai-search'|url_encode }}">lépj be</a> vagy <a href="/register?r={{ '/ai-search'|url_encode }}">regisztrálj</a>, ha még nem tetted</a>!
                    </div>
                    {%  if not form.captchaValidated %}
                        <div class="cf-turnstile" data-sitekey="{{ config_get('services.cloudflare_turnstile.site_key') }}"></div>
                    {% else %}
                        <input type="hidden" name="captchaValidated" value="1"/>
                    {% endif %}
                {% endif %}                    
                <div class="mb-2">
                    <label for="textToSearchAi" class="form-label" required>Keresendő</label>
                    <input required type="text" autocomplete="off" name="textToSearchAi" id="textToSearchAi" value="{{ form.textToSearchAi }}" class="form-control"/>                    
                    {{ errors.first('textToSearchAi') }}
                </div>
                <div class="row g-3 mb-2">
                    <div class="col">
                        <label for="usxCode" class="form-label">Könyv</label>
                        <select name="usxCode" class="form-control" id="usxCode">
                            <option value="all" {{ 'all' == form.usxCode ? 'selected' }}>mind</option>
                            <option value="old_testament" {{ 'old_testament' == form.usxCode ? 'selected' }}>Ószövetség</option>
                            <option value="new_testament" {{ 'new_testament' == form.usxCode ? 'selected' }}>Újszövetség</option>
                            {% for book in books %}
                                <option value="{{ book.usx_code }}" {{ book.usx_code == form.usxCode ? 'selected' }}>{{ book.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col">
                        <label for="translationAbbrev" class="form-label">Fordítás</label>
                        <select name="translationAbbrev" class="form-control" id="translationAbbrev">
                            <option value="0" {{ form.translationAbbrev is not defined ? 'selected' }}>mind</option>
                            {% for translation in translations %}
                                <option value="{{ translation.abbrev }}" {{ translation.abbrev == form.translationAbbrev ? 'selected' }}>{{ translation.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                {{ csrf_field() }}
                <input type="submit" value="Keresés" class="btn btn-primary"/>                
            </form>            
        </div>

    </div>          

    {% if magisterUnavailable is defined %}
        <div class="alert alert-warning" role="alert">
            A jelentés szerinti kereső most nem érhető el. Próbáld újra néhány perc múlva, vagy keress a <a href="/kereses">Részletes keresőben</a>!
        </div>
    {% elseif hits is defined %}
        {% from 'macros' import similarityCircle %}
        <div class="mb-2">
            {% if hits is empty %}
                <p>Nem találtunk a kérdéshez illő szentírási szakaszt.</p>
            {% endif %}
            {% for hit in hits %}
                {% set hitId = 'h' ~ loop.index %}
                <blockquote class="searchResult blockquote mb-3">
                    {% set scoreCircle = similarityCircle(hit.passage.score, color: 'grey', title: 'Relevancia', size: 20) %}
                    {% if hit.passage.heading %}
                        <div class="fw-semibold mb-1">{{ scoreCircle }} {{ hit.passage.heading }}</div>
                    {% else %}
                        {{ scoreCircle }}
                    {% endif %}
                    {% for rendered in hit.translations %}
                        <a data-target="#{{ hitId }}_{{ rendered.translation.abbrev }}" class="searchResultTranslationSelector btn btn-outline-secondary btn-sm {% if loop.first %}active{% endif %}">
                            <i class="bi bi-book"></i> <span>{{ rendered.translation.abbrev }}</span>
                            <span class="header-bookabbrev {{ loop.first ? 'active d-sm-inline' : 'inactive d-md-inline' }}">{{ rendered.reference }}</span>
                        </a>
                    {% endfor %}
                    <div>
                        {% for rendered in hit.translations %}
                            <div class="searchResultTranslationText searchResultVerse {% if loop.first %}active{% endif %}" id="{{ hitId }}_{{ rendered.translation.abbrev }}">
                                <a href="/{{ rendered.translation.abbrev }}/{{ rendered.reference }}"><i class="bi-arrow-right-circle-fill float-start pe-2"></i></a>
                                {% for verseContainer in rendered.verseContainers %}
                                    {% include 'textDisplay.parsedVerseContainer' with { 'verseContainer' : verseContainer, 'translation' : rendered.translation, 'highlightedGepis' : rendered.highlightedGepis } %}
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                    {% if hit.citedBy is not empty %}
                        <div class="small mt-1 churchCitations">
                            <i class="bi bi-bank"></i> Az Egyház tanításában:
                            {% for unitId, url in hit.citedBy %}
                                {% if url %}<a href="{{ url }}" target="_blank" rel="noopener">{{ unitId }}</a>{% else %}{{ unitId }}{% endif %}{{ not loop.last ? ', ' }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </blockquote>
            {% endfor %}
        </div>
    {% endif %}
    <div class="card bg-light mb-2">
        <div class="card-header collapsible" data-bs-toggle="collapse" data-bs-target="#cardContent">
            <i class="bi bi-chevron-down"></i>
            Keresési útmutató
            
    </div>
    <div id="cardContent" class="collapse show">
        <div class="card-body">
            {% apply markdown_to_html %}
A „jelentés szerinti” keresés mesterséges intelligenciát használ a kereséshez, és **másképp működik, mint a hagyományos keresés**. A használatához néhány fontos szempont:
- A kereső a jelentés mellett azt is figyelembe veszi, hogy a Katekizmus és más egyházi dokumentumok mely szentírási szakaszokat idézik a témához. Az idéző dokumentumokat a találat alatt látod, a hivatkozásuk a [katolikus.hu](https://katolikus.hu/dokumentumtar) dokumentumtárába vezet.
- A pozitív és negatív visszajelzéseknek egyaránt örülünk, [Facebook](https://facebook.com/szentiras.eu) oldalunkon vagy Messengeren.
- Pontos idézeteket, szavakat, mondatokat a [Részletes keresőben](/kereses) keress!
- Minél több kontextust adsz a keresésben, annál pontosabbak lesznek a találatok. A *Mit mond Jézus az ellenség szeretetéről?* sokkal jobb lehet, mint az *ellenségszeretet*.
- Ha idézetet keresel, csak nem tudod pontosan a szövegét, akkor próbáld meg idézőjelek között is.
- Kereshetsz bármilyen nyelven bármit, a kereső a jelentéséhez közelálló szentírási szakaszokkal válaszol, a leginkább illő verset kiemelve.
            {% endapply %}
        </div>
    </div>
</div>


{% endblock %}

{% block script %}
    {% if not session_get("anonymous_token") %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
    {% endif %}
{%  endblock %}