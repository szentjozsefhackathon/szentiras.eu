{% extends 'layout.twig' %}
{% set pageTitle = 'Útmutatók/Cikkek | Szentírás' %}

{% block pageHeader %}
<div class="page-header mb-4">
    <h1>Útmutatók/Cikkek</h1>
    <p class="text-muted">Gyakorlati útmutatók és további cikkek a Szentírás.eu használatához.</p>
</div>
{% endblock %}

{% block content %}
<div class="guides-list">
    {% if guides is empty %}
        <div class="alert alert-info">
            Jelenleg nincs elérhető útmutató vagy cikk.
        </div>
    {% else %}
        <div class="list-group shadow-sm">
            {% for guide in guides %}
                <a href="{{ route('guides.show', guide) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3 py-3">
                    <span class="d-flex align-items-start gap-2">
                        <i class="bi bi-journal-text text-primary"></i>
                        <span class="d-flex flex-column align-items-start gap-2">
                            <strong>{{ guide.title }}</strong>
                            {% if guide.tags is not empty %}
                                <span class="d-flex flex-wrap gap-1">
                                    {% for tag in guide.tags %}
                                        <span class="badge rounded-pill bg-secondary">{{ tag.name }}</span>
                                    {% endfor %}
                                </span>
                            {% endif %}
                        </span>
                    </span>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {% if isEditor() %}
        <div class="mt-4">
            <a href="{{ route('editor.guides.index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-pencil-square"></i> Útmutatók/cikkek kezelése
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
