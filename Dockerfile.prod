ARG NODE_VERSION=22-alpine
FROM node:${NODE_VERSION} AS node
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY resources resources
COPY public public
COPY vite.config.js vite.config.js
COPY tailwind.config.* ./
COPY postcss.config.* ./
RUN npm run build
RUN rm -rf node_modules
RUN npm install --omit=dev

FROM php:8.2-apache AS php
WORKDIR /var/www/html

RUN apt-get update && apt-get upgrade -y && \
    apt-get install --no-install-recommends -y \
    cron curl git
# Add extensions not included in the base image
ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN install-php-extensions gd gmp memcached pdo_pgsql pdo_mysql xdebug zip pcntl imagick exif intl

COPY docker/sites-available/000-default.conf.prod /etc/apache2/sites-available/000-default.conf
COPY docker/conf-available/mpm_prefork_tuning.conf /etc/apache2/conf-available/mpm-prefork-tuning.conf
COPY docker/docker-php-entrypoint /usr/local/bin/docker-php-entrypoint
COPY . .
COPY --from=node /app .

RUN php composer.phar install --no-dev --no-interaction --no-cache

ARG GIT_COMMIT_HASH
ENV GIT_COMMIT_HASH=${GIT_COMMIT_HASH}
RUN echo "<?php return [ 'hash' => '$GIT_COMMIT_HASH' ];" > config/version.php

RUN chown -R www-data:www-data bootstrap/cache
RUN chown -R www-data:www-data storage

RUN printf 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n0 * * * * www-data cd /var/www/html && php artisan schedule:run >> /var/www/html/storage/logs/laravel-scheduler.log 2>&1\n' > /etc/cron.d/laravel-scheduler \
    && chmod 0644 /etc/cron.d/laravel-scheduler

RUN cp /usr/local/etc/php/php.ini-production /usr/local/etc/php/php.ini \
    && sed -i 's/memory_limit = .*/memory_limit = 256M/' /usr/local/etc/php/php.ini
RUN a2enmod rewrite headers
RUN a2enconf mpm-prefork-tuning